# ---- secrets ----
# .dashpass: plaintext dashboard password
# auth-fn.js: CloudFront Function, same password base64'd
# .dist: CloudFront distribution id + public hostname
# .ec2env: VPC / security group / AMI of the origin host
# .awsenv: AWS credentials for scheduled runs
.dashpass
auth-fn.js
.dist
.ec2env
.awsenv
.env
*.pem
.aws/

# ---- account-specific config: commit the .example copies instead ----
config.json
bucket-policy.json

# ---- generated by refresh.sh; reproducible, and carries per-user spend ----
spend.db
spend.db-wal
spend.db-shm
spend.db-journal
data.json
rates.json
models.json
index.published.html

# ---- local caches of remote data ----
mirror/
s3dump/
raw_metrics.csv
ce_*.json
cur.json
merged_policy.json

# ---- scratch screenshots and renders ----
*.png

# ---- python / editor / os ----
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
*.swp
